{
  "name": "vermbot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The agent loop that plays the game: given options + game info (+ image), outputs the option to take",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage --run",
    "bench": "vitest bench --run --reporter=verbose",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@games/ff1-state": "link:../../games/ff1/state",
    "@opencode-ai/llm": "link:../../.extern/opencode/packages/llm",
    "effect": "4.0.0-beta.83",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "tsx": "^4.20.7",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
