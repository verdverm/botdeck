{
  "name": "botdeck",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Emulator + agent dashboard (game top-left, state bot-left, agent info right)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage --run",
    "bench": "vitest bench --run --reporter=verbose",
    "bench:browser": "vite --port 5174 --open /bench/index.html",
    "test:e2e": "playwright test",
    "test:e2e:watch": "PW_HEADLESS=false playwright test e2e/watch.spec.ts --project=chromium",
    "test:e2e:perf": "playwright test e2e/performance.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@games/ff1-state": "workspace:*",
    "jsnes": "link:../../.extern/jsnes",
    "json-edit-react": "^1.30.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.1",
    "msw": "^2.15.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.1.9",
    "vitest": "^5.0.2"
  }
}
