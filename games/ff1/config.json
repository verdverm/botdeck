{
  "agent": {
    "model": "small",
    "maxToolRounds": 25,
    "maxTokens": 1024,
    "timeoutMs": 120000,
    "limits": {
      "goals": 1024,
      "memory": 2048,
      "journal": 32768,
      "memoryCount": 10,
      "snippets": 4096,
      "snippetCount": 50
    },
    "recentHistoryLimit": 10,
    "tools": [
      "journal_list",
      "journal_read",
      "journal_write",
      "memory_write",
      "goals_write",
      "press_button",
      "snippet_list",
      "snippet_read",
      "snippet_write",
      "snippet_delete"
    ]
  },
  "prompt": {
    "modes": [
      {
        "id": "overworld",
        "label": "Overworld",
        "systemSnippets": ["system"],
        "userSnippets": ["game-info", "commands", "state", "tools", "goals", "memory", "journal", "overworld"],
        "autoAdvance": true
      },
      {
        "id": "interior",
        "label": "Interior",
        "systemSnippets": ["system"],
        "userSnippets": ["game-info", "commands", "state", "tools", "goals", "memory", "journal", "interior"],
        "autoAdvance": true
      },
      {
        "id": "shop",
        "label": "Shop",
        "systemSnippets": ["system"],
        "userSnippets": ["game-info", "commands", "state", "tools", "goals", "memory", "journal", "shop"],
        "autoAdvance": false
      },
      {
        "id": "battle",
        "label": "Battle",
        "systemSnippets": ["system"],
        "userSnippets": ["game-info", "commands", "state", "tools", "goals", "memory", "journal", "battle"],
        "autoAdvance": true
      }
    ]
  }
}
