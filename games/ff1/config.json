{
  "agent": {
    "model": "small",
    "maxToolRounds": 25,
    "maxTokens": 1024,
    "timeoutMs": 120000,
    "limits": {
      "goals": 1024,
      "memory": 2048,
      "journal": 32768,
      "memoryCount": 10,
      "snippets": 4096,
      "snippetCount": 50
    },
    "recentHistoryLimit": 10,
    "tools": [
      "journal_list",
      "journal_read",
      "journal_write",
      "memory_write",
      "goals_write",
      "press_button",
      "snippet_list",
      "snippet_read",
      "snippet_write",
      "snippet_delete"
    ]
  },
  "prompt": {
    "snippets": ["system", "game-info", "commands", "state", "tools", "goals", "memory", "journal", "instructions"],
    "modes": [
      {
        "id": "field",
        "label": "Field",
        "promptSnippets": ["system", "game-info", "commands", "state", "tools", "goals", "memory", "journal", "field"],
        "autoAdvance": true
      },
      {
        "id": "battle",
        "label": "Battle",
        "promptSnippets": ["system", "game-info", "commands", "state", "tools", "goals", "memory", "journal", "battle"],
        "autoAdvance": true
      },
      {
        "id": "shop",
        "label": "Shop",
        "promptSnippets": ["system", "game-info", "commands", "state", "tools", "goals", "memory", "journal", "shop"],
        "autoAdvance": false
      },
      {
        "id": "inn",
        "label": "Inn",
        "promptSnippets": ["system", "game-info", "commands", "state", "tools", "goals", "memory", "journal", "inn"],
        "autoAdvance": false
      },
      {
        "id": "clinic",
        "label": "Clinic",
        "promptSnippets": ["system", "game-info", "commands", "state", "tools", "goals", "memory", "journal", "clinic"],
        "autoAdvance": false
      }
    ]
  }
}
